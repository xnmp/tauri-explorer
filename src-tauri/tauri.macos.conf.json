{
  "app": {
    "security": {
      "assetProtocol": {
        "scope": {
          "allow": [
            "$HOME/**/*",
            "/Volumes/**/*",
            "/tmp/**/*",
            "/private/tmp/**/*"
          ],
          "deny": [
            "$HOME/.ssh/**",
            "$HOME/.gnupg/**",
            "$HOME/.aws/**",
            "$HOME/.azure/**",
            "$HOME/.kube/**",
            "$HOME/.config/gcloud/**",
            "$HOME/.netrc",
            "$HOME/.docker/config.json"
          ]
        }
      }
    }
  }
}
