{
  "app": {
    "security": {
      "assetProtocol": {
        "scope": {
          "allow": [
            "$HOME/**/*",
            "*:/**/*",
            "*:\\**\\*",
            "//**/*",
            "\\\\**\\*"
          ],
          "deny": [
            "$HOME/.ssh/**",
            "$HOME/.aws/**",
            "$HOME/.azure/**",
            "$HOME/.kube/**",
            "$HOME/AppData/Roaming/gnupg/**",
            "$HOME/.docker/config.json",
            "$HOME/_netrc"
          ]
        }
      }
    }
  }
}
