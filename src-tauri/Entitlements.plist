<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Applied only when a release is Developer ID signed with the hardened runtime
  (#1671, docs/macos-signing.md); unsigned and dev builds ignore this file.
  Apple Events: Delete moves files to the Trash through the trash crate's
  default Finder method (osascript -> Finder, which keeps "Put Back"). The
  hardened runtime denies Apple Events sent on this app's behalf without it.
  scripts/macos-release-build.sh fails the release if it is missing.
-->
<plist version="1.0"><dict>
  <key>com.apple.security.automation.apple-events</key><true/>
</dict></plist>
