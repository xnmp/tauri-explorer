{
  "name": "tauri-explorer",
  "version": "1.21.0",
  "description": "A minimalistic, high-performance file explorer",
  "type": "module",
  "scripts": {
    "dev": "bun run prepare:pdf && vite dev",
    "build": "bun run prepare:pdf && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run && vitest run -c vitest.perf.config.ts",
    "test:watch": "vitest",
    "test:config-watch": "cargo test --manifest-path src-tauri/Cargo.toml --lib config_watch -- --nocapture && cargo test --manifest-path src-tauri/Cargo.toml --test config_watch_nested_root_test --test config_watch_symlinks -- --nocapture",
    "test:portal-lifecycle": "xvfb-run -a cargo test --manifest-path src-tauri/Cargo.toml --test portal_lifecycle -- --ignored",
    "test:perf": "vitest run -c vitest.perf.config.ts",
    "bench:render": "vitest run -c vitest.perf.config.ts --silent=false tests/perf/render.bench.ts",
    "bench:rust": "cd src-tauri && cargo bench",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "test:e2e": "scripts/fsync-safe.sh playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:affected": "specs=\"$(node scripts/e2e-affected.mjs)\"; if [ \"$specs\" = ALL ]; then exec playwright test; elif [ -z \"$specs\" ]; then echo '[e2e:affected] no affected specs'; else exec playwright test $specs; fi",
    "test:e2e:all": "ALL_VIEW_MODES=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:perf": "playwright test e2e/performance.spec.ts",
    "test:e2e:tauri": "wdio run e2e-tauri/wdio.conf.ts",
    "test:e2e:tauri:dnd": "bun scripts/qualify-native-dnd.ts",
    "test:e2e:recovery": "bun e2e-tauri/renderer-recovery.ts",
    "check:e2e:tauri": "tsc --noEmit -p e2e-tauri/tsconfig.json",
    "test:e2e:tauri:soak": "bun run scripts/run-native-soak.ts",
    "test:qualify:macos-startup": "bun run scripts/qualify-macos-startup.ts",
    "build:native:qualification": "bun run scripts/build-native-qualification.ts",
    "test:load": "scripts/fsync-safe.sh playwright test -c playwright.load.config.ts",
    "perf:sweep": "playwright test -c playwright.sweep.config.ts",
    "perf:listing-heap": "node scripts/perf-listing-heap.mjs --max-bytes-per-entry 380",
    "lint:arch": "node scripts/arch-lint.mjs --strict && node scripts/check-file-size.mjs",
    "perf:check": "bun run scripts/perf-check.ts",
    "perf:baseline": "bun run scripts/perf-check.ts --update",
    "clean": "bash scripts/clean-rebuild.sh",
    "clean:fast": "bash scripts/clean-rebuild.sh --no-rust",
    "start": "bash scripts/dev.sh",
    "start:clean": "bash scripts/dev.sh --clean",
    "tauri": "tauri",
    "install-app": "tauri build && sudo rm -rf /Applications/tauri-explorer.app && cp -R src-tauri/target/release/bundle/macos/tauri-explorer.app /Applications/ && fileicon set /Applications/tauri-explorer.app src-tauri/icons/icon.png && killall Dock",
    "prepare:pdf": "node scripts/prepare-pdf-assets.mjs",
    "ci:unit": "bash scripts/ci-test-unit.sh",
    "ci:rust": "bash scripts/ci-test-rust.sh",
    "ci:e2e": "bash scripts/ci-test-e2e.sh"
  },
  "license": "MIT",
  "dependencies": {
    "@chenglou/pretext": "^1.0.0",
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^18.1.2",
    "pdfjs-dist": "^6.4.299",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@jridgewell/sourcemap-codec": "1.6.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2",
    "@types/mocha": "^10.0.10",
    "@types/picomatch": "4.0.3",
    "@vercel/blob": "^2.8.2",
    "@wdio/cli": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "cheerio": "1.2.0",
    "picomatch": "4.0.7",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "turbo": "^2.11.10",
    "typescript": "~7.0.2",
    "undici": "^8.12.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webdriverio": "^10.1.0"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
