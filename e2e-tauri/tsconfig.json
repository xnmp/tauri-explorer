{
  "compilerOptions": {
    // Keep repeated public typechecks within their existing deadline without
    // skipping source/dependency validation. Compiler metadata is disposable.
    "incremental": true,
    "tsBuildInfoFile": "../node_modules/.cache/native-suite.tsbuildinfo",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "mocha", "@wdio/globals/types", "@wdio/mocha-framework"]
  },
  "include": [
    "./**/*.ts",
    // The macOS startup qualifier consumes this module's exported contracts and
    // runs only on a Mac CI runner, so a type error there costs a whole run.
    // It uses node built-ins only, so it type-checks with this configuration.
    "../scripts/qualify-macos-startup.ts",
    "../scripts/qualify-native-dnd.ts"
  ]
}
