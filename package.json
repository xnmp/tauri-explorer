{
  "name": "tauri-explorer",
  "version": "1.6.0",
  "description": "A minimalistic, high-performance file explorer",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run && vitest run -c vitest.perf.config.ts",
    "test:watch": "vitest",
    "test:perf": "vitest run -c vitest.perf.config.ts",
    "bench:render": "vitest run tests/perf/render.bench.ts",
    "bench:rust": "cd src-tauri && cargo bench",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "test:e2e": "scripts/fsync-safe.sh playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:affected": "specs=\"$(node scripts/e2e-affected.mjs)\"; if [ \"$specs\" = ALL ]; then exec playwright test; elif [ -z \"$specs\" ]; then echo '[e2e:affected] no affected specs'; else exec playwright test $specs; fi",
    "test:e2e:all": "ALL_VIEW_MODES=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:perf": "playwright test e2e/performance.spec.ts",
    "test:e2e:tauri": "wdio run e2e-tauri/wdio.conf.ts",
    "test:load": "scripts/fsync-safe.sh playwright test -c playwright.load.config.ts",
    "lint:arch": "node scripts/arch-lint.mjs --strict",
    "perf:check": "bun run scripts/perf-check.ts",
    "perf:baseline": "bun run scripts/perf-check.ts --update",
    "clean": "bash scripts/clean-rebuild.sh",
    "clean:fast": "bash scripts/clean-rebuild.sh --no-rust",
    "start": "bash scripts/dev.sh",
    "start:clean": "bash scripts/dev.sh --clean",
    "tauri": "tauri",
    "install-app": "tauri build && sudo rm -rf /Applications/tauri-explorer.app && cp -R src-tauri/target/release/bundle/macos/tauri-explorer.app /Applications/ && fileicon set /Applications/tauri-explorer.app src-tauri/icons/icon.png && killall Dock"
  },
  "license": "MIT",
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tauri-apps/api": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.69.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2",
    "@types/mocha": "^10.0.10",
    "@wdio/cli": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "svelte": "^5.53.11",
    "svelte-check": "4.7.2",
    "typescript": "~5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "webdriverio": "^9.27.0"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
