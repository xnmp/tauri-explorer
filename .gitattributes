# Normalize line endings across the WSL/Windows boundary.
# Default: git decides text vs binary, and text files are checked out with LF.
* text=auto eol=lf

# Scripts and shell files must stay LF regardless of platform.
*.sh text eol=lf

# Windows-native files that legitimately want CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binary types — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
